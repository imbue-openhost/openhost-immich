#!/usr/bin/with-contenv bash
# Cache only -- no persistence. Immich uses Redis for queue state
# that's safe to lose across restarts (jobs are re-queued from the
# DB on boot). --save "" disables RDB snapshots; --appendonly no
# disables AOF.
exec valkey-server \
    --bind 127.0.0.1 \
    --port 6379 \
    --save "" \
    --appendonly no \
    --maxmemory 256mb \
    --maxmemory-policy allkeys-lru
